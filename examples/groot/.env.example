# Groot — environment configuration.
# Copy to .env (same folder). Or just run `semente launch streamlit` and the
# first-run wizard asks for the missing model values.

APP_ENV="development"
DATABASE_TYPE="sqlite"

PRIMARY_MODEL_PROVIDER="google"
PRIMARY_MODEL_ID="gemini-3.5-flash-lite"
GOOGLE_API_KEY=""

# Optional: where the Markdown docs live (default: ../../docs of this repo).
# SEMENTE_DOCS_DIR="/path/to/docs"
